# Copia este archivo a .env en la raíz del repositorio.
# No pongas aquí un dominio propio: la beta usa localhost o la URL de pruebas que te asigne el hosting.

# SQLite local (recomendado para probar sin Docker):
DATABASE_URL=file:./dev.db
# PostgreSQL (Docker o hosting):
# DATABASE_URL=postgresql://hivex:hivex@localhost:5432/hivex

# Secreto para las sesiones. Cámbialo en cualquier servidor público.
JWT_SECRET=cambia-este-secreto-largo

# Origen extra permitido (CORS). En local, el puerto de Vite.
# En Render no hace falta: el servidor lee RENDER_EXTERNAL_URL y la web sale del mismo servicio.
WEB_ORIGIN=http://localhost:5173

# Puerta de todo el sitio (web, API y WebSocket). Solo se activa si las dos tienen valor.
# En local déjalas vacías. /api/salud nunca pide esta contraseña.
# La sesión de la app va en X-HIVEX-Token, así puede convivir con esta puerta.
ACCESS_USER=
ACCESS_PASSWORD=

# Las fotos viven en disco. En un hosting gratuito se pierden al redesplegar.
# Estas variables quedan reservadas para un almacenamiento compatible con S3; hoy no se usan.
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

PORT=8787

# Carpeta de fotos (relativa a apps/server cuando arrancas en local).
UPLOAD_DIR=./uploads

# 1 = el servidor también sirve la web ya compilada (Docker / Render / Railway).
SERVE_STATIC=0
# WEB_DIST=/app/apps/web/dist

# 1 = al arrancar, crea la empresa de demostración solo si todavía no existe. No borra datos.
SEED_ON_BOOT=0

# Audio/vídeo de proximidad con LiveKit. Si se dejan vacías, la oficina usa
# conexión directa entre navegadores y muestra un aviso.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
