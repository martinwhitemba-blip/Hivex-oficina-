{
  "name": "@hivex/server",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --packages=external",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "pretest": "DATABASE_URL=file:./test.db node scripts/prisma-provider.mjs && DATABASE_URL=file:./test.db prisma db push --accept-data-loss",
    "test": "vitest run",
    "db:push": "node scripts/with-root-env.mjs node scripts/prisma-provider.mjs && node scripts/with-root-env.mjs prisma db push",
    "seed": "node scripts/with-root-env.mjs tsx prisma/seed.ts",
    "setup": "npm run db:push && npm run seed",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.2.0",
    "@prisma/client": "^6.6.0",
    "bcryptjs": "^2.4.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.3.3",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.13.0",
    "prisma": "^6.6.0",
    "sharp": "^0.34.2",
    "socket.io": "^4.8.1",
    "tsx": "^4.19.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.3",
    "esbuild": "^0.25.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
